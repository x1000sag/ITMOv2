{
  "$schema": "https://opencode.ai/config.json",
  "model": "lmstudio/qwen/qwen3.8-27b",
  "small_model": "lmstudio/qwen/qwen3.8-27b",
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio",
      "options": {
        "baseURL": "http://172.31.176.1:1234/v1", // localhost для wsl
        "apiKey": "{env:LOCAL_API_KEY}"
      },
      "models": {
        "qwen/qwen3.8-27b": {
          "name": "qwen/qwen3.8-27b q4_K_M",
          "limit": {
            "context": 30720,
            "output": 2048
          }
        }
      }
    }
  },
  "agent": {
    "local-guide": {
      "description": "Read-only local repository assistant",
      "mode": "primary",
      "prompt": "{file:./system.txt}",
      "steps": 8,
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow"
      }
    }
  }
}
