<Project>
  <PropertyGroup>
    <MSBuildEnableWorkloadResolver>false</MSBuildEnableWorkloadResolver>
    <EnableNETWorkloads>false</EnableNETWorkloads>
    <UseWorkloadManifest>false</UseWorkloadManifest>
    <SkipImportNetSdkWorkloadManifestTargets>true</SkipImportNetSdkWorkloadManifestTargets>
  </PropertyGroup>
</Project>
