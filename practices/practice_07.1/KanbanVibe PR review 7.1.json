    {
      "parameters": {
        "jsCode": "const MAX_HUNKS = 8;\nconst MAX_PATCH_CHARS = 3500;\nconst diffItem = $('Get PR diff1').first().json;\nconst diffText = (typeof diffItem.data === 'string' && diffItem.data) || (typeof diffItem.body === 'string' && diffItem.body) || '';\nconst trigger = $('Back_pr-trigger').first().json;\nconst prNumber = trigger.body.issue.number;\nconst meta = $('Get PR meta1').first().json;\nlet commitId = meta.head?.sha || meta.body?.head?.sha || meta.data?.head?.sha;\nif (!commitId) throw new Error('commit_id not found — check Get PR meta');\nif (!diffText.trim()) throw new Error('Empty diff');\nconst hunks = [];\nlet file = '';\nlet current = null;\nfor (const line of diffText.split('\\n')) {\n  if (line.startsWith('diff --git ')) {\n    const m = line.match(/ b\\/(.+)$/);\n    file = m ? m[1] : '';\n    current = null;\n    continue;\n  }\n  if (line.startsWith('@@')) {\n    const m = line.match(/@@ -\\d+(?:,\\d+)? \\+(\\d+)(?:,(\\d+))? @@/);\n    const startLine = m ? parseInt(m[1], 10) : 1;\n    current = { path: file, line: startLine, patchLines: [line] };\n    hunks.push(current);\n    continue;\n  }\n  if (current && (line.startsWith(' ') || line.startsWith('+') || line.startsWith('-'))) {\n    if (line.startsWith('+++') || line.startsWith('---')) continue;\n    current.patchLines.push(line);\n    if (line.startsWith('+')) {\n      current._lineCounter = (current._lineCounter ?? current.line - 1) + 1;\n      current.line = current._lineCounter;\n    }\n  }\n}\nconst items = [];\nfor (const h of hunks) {\n  const patch = h.patchLines.join('\\n');\n  const hasChange = patch.split('\\n').some((l) => l.startsWith('+') && !l.startsWith('+++'));\n  if (!h.path || !hasChange) continue;\n  if (h.path.includes('package-lock')) continue;\n  items.push({\n    path: h.path,\n    line: Math.max(1, h.line),\n    patch: patch.slice(0, MAX_PATCH_CHARS),\n    commit_id: commitId,\n    pr_number: prNumber,\n  });\n  if (items.length >= MAX_HUNKS) break;\n}\nif (!items.length) throw new Error('No hunks');\nreturn items.map((json) => ({ json }));"
      },
