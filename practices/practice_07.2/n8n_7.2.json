    {
      "parameters": {
        "jsCode": "function has(lower, word) { return lower.includes(word); }\nfunction scoreHeuristic(title, body) {\n  const lower = `${title}\\n${body}`.toLowerCase();\n  const titleLower = title.toLowerCase();\n  let bug = 0, task = 0, feature = 0;\n  if (has(lower, 'вместо')) bug += 2;\n  if (has(lower, 'ожидание') && has(lower, 'факт')) bug += 3;\n  else if (has(lower, 'ожидание')) bug += 1;\n  if (has(lower, 'возвращает')) bug += 2;\n  if (/\\b\\d{3}\\b/.test(lower) && (has(lower, 'вместо') || /nick_invalid|store_unavailable/i.test(lower))) bug += 3;\n  if (/(?:post|get|put|patch|delete)\\s+\\//i.test(lower) && (has(lower, 'возвращает') || has(lower, 'вместо'))) bug += 2;\n  if (/netsdk\\d+/i.test(lower)) bug += 2;\n  if (has(lower, 'падает') || /не\\s+работает/.test(lower)) bug += 1;\n  if (has(lower, 'воспроизвед')) bug += 1;\n  if (has(titleLower, 'возвращает') && has(titleLower, 'вместо')) bug += 5;\n  if (has(titleLower, 'падает')) bug += 2;\n  if (/обновить.*\\.md|manual-test|документац|подтянуть.*тег/i.test(lower)) task += 2;\n  if (/(?:слить|merge).*(?:ветк|branch)/i.test(lower)) task += 2;\n  if (/рефактор|ci\\/cd|зависимост/i.test(lower)) task += 1;\n  if (has(lower, 'добавить') && !has(titleLower, 'вместо')) feature += 1;\n  if (/новая\\s+возможност|фильтр\\s+карточ|интеграц|mock.*production/i.test(lower)) feature += 2;\n  if (/фильтр\\s+карточек\\s+по\\s+метке/i.test(lower)) feature += 3;\n  const entries = [['bug', bug], ['task', task], ['feature', feature]].sort((a, b) => b[1] - a[1]);\n  const [bestType, bestScore] = entries[0];\n  if (bestScore < 2) return null;\n  if (entries[1][1] === bestScore) return null;\n  return { type: bestType, confidence: Math.min(0.99, 0.55 + 0.05 * bestScore) };\n}\nfunction parseJsonish(value) {\n  if (typeof value !== 'string') return value;\n  const trimmed = value.trim().replace(/^```(?:json)?\\s*/i, '').replace(/\\s*```$/, '');\n  try { return JSON.parse(trimmed); } catch (e) { return value; }\n}\nfunction classificationFrom(value, depth) {\n  if (depth > 6 || value == null) return null;\n  const parsed = parseJsonish(value);\n  if (typeof parsed !== 'object' || parsed === null || Array.isArray(parsed)) return null;\n  const nested = parsed.output ?? parsed.result ?? parsed.data ?? parsed.response ?? parsed.text;\n  const inner = nested != null ? classificationFrom(nested, depth + 1) : null;\n  const ownType = parsed.type ?? parsed.label ?? parsed.category;\n  const ownConfidence = parsed.confidence ?? parsed.score;\n  if (inner && ownType == null) return inner;\n  if (ownType != null || ownConfidence != null) {\n    return { type: ownType ?? inner?.type, confidence: ownConfidence ?? inner?.confidence };\n  }\n  return inner;\n}\nconst j = classificationFrom($input.first().json, 0) || $input.first().json || {};\nlet rawType = String(j.type ?? 'unknown').toLowerCase().trim();\nconst typeAliases = { defect: 'bug', баг: 'bug', дефект: 'bug', chore: 'task', enhancement: 'feature' };\nif (typeAliases[rawType]) rawType = typeAliases[rawType];\nconst words = { high: 0.92, medium: 0.6, low: 0.35, высокая: 0.92, средняя: 0.6, низкая: 0.35 };\nlet confidence = j.confidence;\nif (typeof confidence === 'string') {\n  const word = confidence.trim().toLowerCase();\n  confidence = Object.prototype.hasOwnProperty.call(words, word)\n    ? words[word]\n    : Number(word.replace('%', '').replace(',', '.'));\n} else confidence = Number(confidence);\nif (Number.isFinite(confidence) && confidence > 1 && confidence <= 100) confidence = confidence / 100;\nif (!Number.isFinite(confidence)) confidence = 0;\nconfidence = Math.max(0, Math.min(1, confidence));\nconst allowed = ['bug', 'task', 'feature'];\nlet type = allowed.includes(rawType) ? rawType : 'unknown';\nlet title = '';\nlet body = '';\nfor (const nodeName of ['Heuristic classify', 'Prepare issue text', 'When called']) {\n  try {\n    const src = $(nodeName).first().json;\n    title = String(src.title ?? title);\n    body = String(src.body ?? body);\n  } catch (e) {}\n}\nconst heuristic = scoreHeuristic(title, body);\nif (heuristic && (type === 'unknown' || confidence < 0.8)) {\n  type = heuristic.type;\n  confidence = Math.max(confidence, heuristic.confidence);\n} else if (heuristic && type === heuristic.type && confidence < 0.8) {\n  confidence = Math.max(confidence, heuristic.confidence);\n} else if (!heuristic && type === 'unknown' && confidence < 0.55) {\n  confidence = 0.3;\n}\nreturn [{ json: { type, confidence } }];"
