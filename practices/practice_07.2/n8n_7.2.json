    {
      "parameters": {
        "jsCode": "const title = String($json.title ?? '').trim();\nconst body = String($json.body ?? '').trim();\nconst text = `Заголовок: ${title}\\n\\nТекст issue:\\n${body || '(пусто)'}`;\nreturn [{ json: { title, body, text } }];"
