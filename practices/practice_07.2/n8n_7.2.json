      "name": "Prepare issue text"
    },
    {
      "parameters": {
        "jsCode": "function has(lower, word) { return lower.includes(word); }\nfunction scoreHeuristic(title, body) {\n  const lower = `${title}\\n${body}`.toLowerCase();\n  const titleLower = title.toLowerCase();\n  let bug = 0, task = 0, feature = 0;\n  if (has(lower, 'вместо')) bug += 2;\n  if (has(lower, 'ожидание') && has(lower, 'факт')) bug += 3;\n  else if (has(lower, 'ожидание')) bug += 1;\n  if (has(lower, 'возвращает')) bug += 2;\n  if (/\\b\\d{3}\\b/.test(lower) && (has(lower, 'вместо') || /nick_invalid|store_unavailable/i.test(lower))) bug += 3;\n  if (/(?:post|get|put|patch|delete)\\s+\\//i.test(lower) && (has(lower, 'возвращает') || has(lower, 'вместо'))) bug += 2;\n  if (/netsdk\\d+/i.test(lower)) bug += 2;\n  if (has(lower, 'падает') || /не\\s+работает/.test(lower)) bug += 1;\n  if (has(lower, 'воспроизвед')) bug += 1;\n  if (has(titleLower, 'возвращает') && has(titleLower, 'вместо')) bug += 5;\n  if (has(titleLower, 'падает')) bug += 2;\n  if (/обновить.*\\.md|manual-test|документац|подтянуть.*тег/i.test(lower)) task += 2;\n  if (/(?:слить|merge).*(?:ветк|branch)/i.test(lower)) task += 2;\n  if (/рефактор|ci\\/cd|зависимост/i.test(lower)) task += 1;\n  if (has(lower, 'добавить') && !has(titleLower, 'вместо')) feature += 1;\n  if (/новая\\s+возможност|фильтр\\s+карточ|интеграц|mock.*production/i.test(lower)) feature += 2;\n  if (/фильтр\\s+карточек\\s+по\\s+метке/i.test(lower)) feature += 3;\n  const entries = [['bug', bug], ['task', task], ['feature', feature]].sort((a, b) => b[1] - a[1]);\n  const [bestType, bestScore] = entries[0];\n  if (bestScore < 2) return null;\n  if (entries[1][1] === bestScore) return null;\n  return { type: bestType, confidence: Math.min(0.99, 0.55 + 0.05 * bestScore) };\n}\nconst title = String($json.title ?? '').trim();\nconst body = String($json.body ?? '').trim();\nconst text = String($json.text ?? `Заголовок: ${title}\\n\\nТекст issue:\\n${body || '(пусто)'}`);\nconst h = scoreHeuristic(title, body);\nlet type = 'unknown';\nlet confidence = 0.3;\nlet fromHeuristic = false;\nif (h) {\n  type = h.type;\n  confidence = h.confidence;\n  if (['bug', 'task', 'feature'].includes(type) && confidence >= 0.55) fromHeuristic = true;\n}\nreturn [{ json: { title, body, text, type, confidence, fromHeuristic } }];"
      },
