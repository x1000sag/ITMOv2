    {
      "parameters": {
        "jsCode": "const since = $now.minus({ days: 7 }).toFormat('yyyy-MM-dd');\nconst weekStart = since;\nfunction firstJson(name) {\n  try {\n    return $(name).first().json || {};\n  } catch (e) {\n    return {};\n  }\n}\nfunction itemsOf(name) {\n  const j = firstJson(name);\n  return Array.isArray(j.items) ? j.items : [];\n}\nconst opened = itemsOf('Issues opened');\nconst closed = itemsOf('Issues closed');\nconst prs = itemsOf('PRs opened');\nconst labeled = itemsOf('Issues updated');\nfunction byAuthor(list) {\n  const m = {};\n  for (const it of list) {\n    const login = it.user?.login || 'unknown';\n    m[login] = (m[login] || 0) + 1;\n  }\n  return m;\n}\nfunction byLabel(list) {\n  const m = { bug: 0, task: 0, feature: 0, 'needs-triage': 0, other: 0 };\n  for (const it of list) {\n    const names = (it.labels || []).map((l) => (typeof l === 'string' ? l : l.name));\n    let hit = false;\n    for (const n of ['bug', 'task', 'feature', 'needs-triage']) {\n      if (names.includes(n)) { m[n] += 1; hit = true; }\n    }\n    if (!hit) m.other += 1;\n  }\n  return m;\n}\nconst authors = byAuthor(opened);\nconst types = byLabel(labeled.length ? labeled : opened);\nlet prev = null;\ntry {\n  const rows = $('Previous stats').all().map((i) => i.json).filter((r) => r && r.week_start);\n  rows.sort((a, b) => String(b.week_start).localeCompare(String(a.week_start)));\n  prev = rows[0] || null;\n} catch (e) { prev = null; }\nconst delta = (cur, key) => {\n  if (!prev || prev[key] === undefined || prev[key] === null || prev[key] === '') return 'n/a';\n  const d = Number(cur) - Number(prev[key]);\n  return (d > 0 ? '+' : '') + d;\n};\nconst authorRows = Object.entries(authors).sort((a, b) => b[1] - a[1])\n  .map(([k, v]) => `<tr><td>${k}</td><td>${v}</td></tr>`).join('') || '<tr><td colspan=\"2\">нет</td></tr>';\nconst typeRows = Object.entries(types).map(([k, v]) => `<tr><td>${k}</td><td>${v}</td></tr>`).join('');\nconst html = `<h2>KanbanVibe за неделю с ${weekStart}</h2>\n<table border=\"1\" cellpadding=\"6\"><tr><th></th><th>Сейчас</th><th>Δ к прошлой</th></tr>\n<tr><td>Issues opened</td><td>${opened.length}</td><td>${delta(opened.length, 'opened')}</td></tr>\n<tr><td>Issues closed</td><td>${closed.length}</td><td>${delta(closed.length, 'closed')}</td></tr>\n<tr><td>PRs opened</td><td>${prs.length}</td><td>${delta(prs.length, 'prs')}</td></tr>\n</table>\n<h3>По типу</h3><table border=\"1\" cellpadding=\"6\"><tr><th>label</th><th>count</th></tr>${typeRows}</table>\n<h3>По автору (opened)</h3><table border=\"1\" cellpadding=\"6\"><tr><th>login</th><th>count</th></tr>${authorRows}</table>\n<h3>AI</h3><p>{{AI}}</p>`;\nreturn [{ json: {\n  week_start: weekStart,\n  opened: opened.length,\n  closed: closed.length,\n  prs: prs.length,\n  by_type: types,\n  by_author: authors,\n  html,\n}}];\n"
      },
